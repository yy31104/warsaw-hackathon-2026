# Copy to .env (git-ignored). Never commit real keys.
DATABASE_URL=postgresql://alerting:alerting@localhost:5432/alerting
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
SMTP_HOST=localhost
SMTP_PORT=1025
FAKE_TELECOM_URL=http://localhost:8100
MOCK_OPS_URL=http://localhost:8200
CONFIG_DIR=../config
DEMO_MODE=1
CORS_ORIGINS=http://localhost:5173
INBOUND_SECRET=change-me-local-only      # fake-telecom -> /v1/inbound/* shared secret
DELIVERY_TARGET_S=30                     # delivery-risk threshold for the oldest pending notification

# LLM assist (optional — the system works without it)
ASSIST_ENABLED=1
ASSIST_PROVIDER=openai                   # openai | anthropic
ASSIST_MODEL=                            # exact model id from the provider's model list (M3 eval picks the default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
